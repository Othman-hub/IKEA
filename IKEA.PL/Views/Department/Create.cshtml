@model CreatedDepartmenDto
@{
    ViewData["Title"] = "Create";
}
<div class="row justify-content-center align-content-center flex-column">
    <h1 class="col-6 my-4">Create Department</h1>
    <form asp-action="Create" method="post" class="col-6">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="form-group mp-3">
            <label class="form-label" asp-for="Code"></label>
            <input asp-for="Code" class="form-control"/>
            <span class="text-danger" asp-validation-for="Code"></span>
        </div>
        <div class="form-group mp-3">
            <label class="flabel" asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span class="text-danger" asp-validation-for="Name"></span>
        </div>
        <div class="form-group mp-3">
            <label class="form-label" asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>
        <div class="form-group mp-3">
            <label class="form-label" asp-for="CreationDate"></label>
            <input asp-for="CreationDate" type="date" class="form-control" />
        </div>
        <div class="mt-4">
            <input type="submit" value="Create" class="btn btn-primary" /> |
            <a asp-action="Index" class="btn btn-secondary">Back To List</a>
        </div>
    </form>

</div>
@section ValidateScripts
{
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}

